generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  password            String?
  emailVerified       DateTime?
  image               String?
  isPremium           Boolean              @default(false)
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  whiteLabelSettings   WhiteLabelSettings?
  SEOToolResult       SEOToolResult[]
  siteAudits          SiteAudit[]
  keywordTracking     KeywordTracking[]
  competitorAnalysis  CompetitorAnalysis[]
  backlinkAnalyses    BacklinkAnalysis[]
  keywordResearch     KeywordResearch[]
  serpAnalyses        SerpAnalysis[]
  contentAnalyses     ContentAnalysis[]
  positionTracking    PositionTracking[]
  domainOverviews     DomainOverview[]
  topicResearch       TopicResearch[]
  notifications       Notification[]
}

model ServiceRequest {
  id                     String               @id @default(cuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  question               String
  websiteType            String
  reference              String?
  name                   String
  phoneNumber            String
  email                  String
  brandName              String
  brandAge               String
  brandDescription       String
  hasDomain              Boolean
  domainName             String?
  websitesUnderDomain    String?
  hasHosting             Boolean
  needsLogo              Boolean
  categoryPages          String
  needsContent           Boolean
  providingProductImages Boolean
  additionalRequirements String?
  budget                 String
  status                 ServiceRequestStatus @default(PENDING)

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model ContactRequest {
  id        String   @id
  name      String
  email     String
  phone     String?
  service   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime

}

model Domain {
  id         Int      @id @default(autoincrement())
  domainName String   @unique
  ipAddress  String?
  pdfData    Bytes?
  pdfPath    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  userId     String?
}

model KeywordSearch {
  id         Int      @id @default(autoincrement())
  keyword    String
  platform   String
  searchType String
  country    String
  language   String
  createdAt  DateTime @default(now())
  results    Json
  userId     String?
}

model SEOToolResult {
  id        String      @id
  userId    String
  toolType  SEOToolType
  url       String
  result    Json
  createdAt DateTime    @default(now())
  updatedAt DateTime
  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolType])
  @@index([userId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model UserUsage {
  id               Int      @id @default(autoincrement())
  userId           String   @unique
  freeReportsUsed  Int      @default(0)
  freeSearchesUsed Int      @default(0)
  lastResetDate    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  USER
  FREELANCER
  CLIENT
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SEOToolType {
  META_TAGS
  KEYWORD_DENSITY
  HEADER_TAGS
  INTERNAL_LINKS
  ALT_TEXT
  BROKEN_LINKS
  ROBOTS_TXT
  SITEMAP
  SEO_SCORE
  READABILITY
  TITLE_PREVIEW
  DESCRIPTION_PREVIEW
  STRUCTURED_DATA
  CANONICAL_URL
  MOBILE_FRIENDLY
  FULL_AUDIT
  ACCESSIBILITY_AUDIT
  PERFORMANCE_AUDIT
  COMPETITOR_ANALYSIS
  DOMAIN_OVERVIEW
  ORGANIC_RESEARCH
  KEYWORD_GAP
  BACKLINK_GAP
  KEYWORD_RESEARCH
  KEYWORD_OVERVIEW
  KEYWORD_MAGIC_TOOL
  KEYWORD_STRATEGY_BUILDER
  POSITION_TRACKING
  ORGANIC_TRAFFIC_INSIGHTS
  BACKLINK_ANALYTICS
  BACKLINK_AUDIT
  LINK_BUILDING_TOOL
  BULK_ANALYSIS
  ON_PAGE_SEO_CHECKER
  LOG_FILE_ANALYZER
  CONTENT_IDEAS
  SEO_WRITING_ASSISTANT
  TOPIC_RESEARCH
  SEO_CONTENT_TEMPLATE
}

model SiteAudit {
  id                    String              @id @default(cuid())
  userId                String
  url                   String
  status                AuditStatus         @default(PENDING)
  digitalCertaintyIndex Int?                @default(0)
  seoScore             Int?                @default(0)
  accessibilityScore   Int?                @default(0)
  performanceScore     Int?                @default(0)
  qualityScore         Int?                @default(0)
  totalPages           Int?                @default(0)
  crawledPages         Int?                @default(0)
  totalIssues          Int?                @default(0)
  criticalIssues       Int?                @default(0)
  warningIssues        Int?                @default(0)
  infoIssues           Int?                @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditResults         AuditResult[]
  auditIssues          AuditIssue[]
  auditReports         AuditReport[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditResult {
  id          String    @id @default(cuid())
  auditId     String
  category    String    // SEO, Accessibility, Performance, Quality
  subcategory String    // Meta tags, Images, Links, etc.
  score       Int       @default(0)
  maxScore    Int       @default(100)
  data        Json
  createdAt   DateTime  @default(now())
  audit       SiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([category])
}

model AuditIssue {
  id          String      @id @default(cuid())
  auditId     String
  severity    IssueSeverity
  category    String
  title       String
  description String
  pageUrl     String?
  element     String?
  suggestion  String?
  isFixed     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  audit       SiteAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@index([category])
}

model AuditReport {
  id          String      @id @default(cuid())
  auditId     String
  title       String
  description String?
  reportType  ReportType
  format      ReportFormat
  filePath    String?
  isPublic    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  audit       SiteAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([reportType])
}

model KeywordTracking {
  id            String   @id @default(cuid())
  userId        String
  keyword       String
  targetUrl     String
  currentRank   Int?
  previousRank  Int?
  searchVolume  Int?
  difficulty    Int?
  country       String   @default("US")
  language      String   @default("en")
  isTracking    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyword])
  @@index([isTracking])
}

model CompetitorAnalysis {
  id               String   @id @default(cuid())
  userId           String
  primaryDomain    String
  competitorDomain String
  analysisData     Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([primaryDomain])
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

enum ReportType {
  FULL_AUDIT
  SEO_SUMMARY
  ACCESSIBILITY_SUMMARY
  PERFORMANCE_SUMMARY
  CUSTOM
}

enum ReportFormat {
  PDF
  CSV
  JSON
  HTML
}

// Advanced SEO Analysis Models
model BacklinkAnalysis {
  id               String   @id @default(cuid())
  userId           String
  domain           String
  backlinks        Backlink[]
  referringDomains Int      @default(0)
  domainAuthority  Float?
  spamScore        Float?   @default(0)
  newBacklinks     Int      @default(0)
  lostBacklinks    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
}

model Backlink {
  id                   String          @id @default(cuid())
  backlinkAnalysisId   String
  sourceUrl            String
  sourceDomain         String
  sourceTitle          String?
  targetUrl            String
  anchorText           String?
  linkType             LinkType        @default(TEXT)
  isDofollow           Boolean         @default(true)
  domainAuthority      Float?
  pageAuthority        Float?
  spamScore            Float?          @default(0)
  firstSeen            DateTime        @default(now())
  lastSeen             DateTime        @default(now())
  status               BacklinkStatus  @default(ACTIVE)
  backlinkAnalysis     BacklinkAnalysis @relation(fields: [backlinkAnalysisId], references: [id], onDelete: Cascade)

  @@index([backlinkAnalysisId])
  @@index([sourceDomain])
  @@index([status])
}

model KeywordResearch {
  id            String   @id @default(cuid())
  userId        String
  keyword       String
  searchVolume  Int?
  difficulty    Int?
  cpc           Float?
  competition   CompetitionLevel?
  trend         Json?    // Monthly search trend data
  relatedKeywords Json?  // Array of related keywords
  serpFeatures  Json?    // SERP features for this keyword
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyword])
}

model SerpAnalysis {
  id             String   @id @default(cuid())
  userId         String
  keyword        String
  searchEngine   String   @default("google")
  location       String   @default("us")
  language       String   @default("en")
  results        Json     // SERP results with positions, titles, descriptions
  serpFeatures   Json?    // Featured snippets, ads, etc.
  topCompetitors Json?    // Analysis of top ranking domains
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyword])
}

model ContentAnalysis {
  id              String   @id @default(cuid())
  userId          String
  url             String
  title           String?
  wordCount       Int?
  readabilityScore Float?
  keywordDensity  Json?    // Keyword density analysis
  sentimentScore  Float?
  topicRelevance  Json?    // Topic relevance analysis
  contentQuality  Json?    // Overall content quality metrics
  recommendations Json?    // Optimization suggestions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([url])
}

model PositionTracking {
  id              String   @id @default(cuid())
  userId          String
  keyword         String
  targetUrl       String?
  searchEngine    String   @default("google")
  location        String   @default("us")
  device          Device   @default(DESKTOP)
  currentRank     Int?
  previousRank    Int?
  rankHistory     Json?    // Historical ranking data
  searchVolume    Int?
  difficulty      Int?
  urlCount        Int?     // Number of URLs tracking for this keyword
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyword])
  @@index([targetUrl])
}

model DomainOverview {
  id                  String   @id @default(cuid())
  userId              String
  domain              String
  domainAge           Int?
  domainAuthority     Float?
  pageAuthority       Float?
  spamScore           Float?
  backlinkCount       Int?
  referringDomains    Int?
  organicKeywords     Int?
  organicTraffic      Int?
  paidKeywords        Int?
  paidTraffic         Int?
  topPages            Json?    // Top performing pages
  topKeywords         Json?    // Top ranking keywords
  competitorData      Json?    // Competitor comparison data
  technicalSeo        Json?    // Technical SEO metrics
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
}

model TopicResearch {
  id            String   @id @default(cuid())
  userId        String
  topic         String
  searchVolume  Int?
  difficulty    Float?
  relevanceScore Float?
  relatedTopics Json?    // Related topic suggestions
  questions     Json?    // Popular questions about the topic
  subtopics     Json?    // Subtopic breakdown
  contentGap    Json?    // Content gap analysis
  serpIntent    String?  // Search intent classification
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topic])
}


// Enums for new models
enum LinkType {
  TEXT
  IMAGE
  REDIRECT
  JAVASCRIPT
}

enum BacklinkStatus {
  ACTIVE
  LOST
  BROKEN
  DISAVOWED
}

enum CompetitionLevel {
  LOW
  MEDIUM
  HIGH
}

enum Device {
  DESKTOP
  MOBILE
  TABLET
}

model WhiteLabelSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  companyName       String?
  logo              String?  // Base64 encoded image or URL
  brandColor        String?  @default("#1a365d")
  removeBranding    Boolean  @default(false)
  contactEmail      String?
  contactPhone      String?
  contactWebsite    String?
  footerText        String?
  defaultReportTitle String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

model AuditAttempt {
  id          String   @id @default(cuid())
  url         String
  ipHash      String   // Hashed IP for non-authenticated users
  userId      String?  // Optional - for authenticated users
  attemptDate DateTime @default(now())
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([url, attemptDate])
  @@index([userId, attemptDate])
  @@index([ipHash, attemptDate])
}


model Suggestion {
  id        String   @id @default(cuid())
  email     String
  comment   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
