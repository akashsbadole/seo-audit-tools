generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model ApiCost {
  id               String      @id
  provider         ApiProvider
  userId           String?
  dailyLimit       Decimal     @db.Decimal(10, 4)
  dailySpent       Decimal     @default(0.0000) @db.Decimal(10, 4)
  monthlyLimit     Decimal     @db.Decimal(10, 4)
  monthlySpent     Decimal     @default(0.0000) @db.Decimal(10, 4)
  perRequestCost   Decimal     @default(0.0000) @db.Decimal(10, 4)
  dailyResetTime   DateTime?
  monthlyResetTime DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  User             User?       @relation(fields: [userId], references: [id])

  @@index([dailySpent])
  @@index([monthlySpent])
  @@index([provider])
  @@index([userId])
}

model ApiQuota {
  id                 String      @id
  provider           ApiProvider
  userId             String?
  dailyLimit         Int
  dailyUsed          Int         @default(0)
  monthlyLimit       Int
  monthlyUsed        Int         @default(0)
  perSecondLimit     Int
  perSecondUsed      Int         @default(0)
  dailyResetTime     DateTime?
  monthlyResetTime   DateTime?
  perSecondResetTime DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime
  User               User?       @relation(fields: [userId], references: [id])

  @@index([dailyUsed])
  @@index([monthlyUsed])
  @@index([provider])
  @@index([userId])
}

model ApiUsage {
  id               String             @id
  provider         ApiProvider
  userId           String?
  requestType      String
  requestCount     Int                @default(1)
  cost             Decimal            @default(0.0000) @db.Decimal(10, 4)
  status           ApiRequestStatus   @default(PENDING)
  requestId        String?
  requestData      Json?
  responseData     Json?
  errorMessage     String?
  responseTime     Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  User             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  BacklinkData     BacklinkData[]
  CompetitorData   CompetitorData[]
  KeywordData      KeywordData[]
  PageSpeedResults PageSpeedResults[]

  @@index([createdAt])
  @@index([provider])
  @@index([status])
  @@index([userId])
}

model AuditIssue {
  id          String        @id
  auditId     String
  severity    IssueSeverity
  category    String
  title       String
  description String
  pageUrl     String?
  element     String?
  suggestion  String?
  isFixed     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  SiteAudit   SiteAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([category])
  @@index([severity])
}

model AuditReport {
  id          String       @id
  auditId     String
  title       String
  description String?
  reportType  ReportType
  format      ReportFormat
  filePath    String?
  isPublic    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  SiteAudit   SiteAudit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([reportType])
}

model AuditResult {
  id          String    @id
  auditId     String
  category    String
  subcategory String
  score       Int       @default(0)
  maxScore    Int       @default(100)
  data        Json
  createdAt   DateTime  @default(now())
  SiteAudit   SiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([category])
}

model BacklinkData {
  id               String      @id
  url              String
  backlinks        Int         @default(0)
  referringDomains Int         @default(0)
  domainAuthority  Int         @default(0)
  pageAuthority    Int         @default(0)
  spamScore        Int         @default(0)
  anchorTexts      Json?
  newBacklinks     Int         @default(0)
  lostBacklinks    Int         @default(0)
  provider         ApiProvider
  apiUsageId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  ApiUsage         ApiUsage?   @relation(fields: [apiUsageId], references: [id])

  @@index([createdAt])
  @@index([domainAuthority])
  @@index([provider])
  @@index([url])
}

model CompetitorAnalysis {
  id               String   @id
  userId           String
  primaryDomain    String
  competitorDomain String
  analysisData     Json
  createdAt        DateTime @default(now())
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([primaryDomain])
  @@index([userId])
}

model CompetitorData {
  id               String      @id
  domain           String
  traffic          Int         @default(0)
  keywords         Int         @default(0)
  backlinks        Int         @default(0)
  domainAuthority  Int         @default(0)
  rankDistribution Json?
  topKeywords      Json?
  contentGaps      Json?
  provider         ApiProvider
  apiUsageId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  ApiUsage         ApiUsage?   @relation(fields: [apiUsageId], references: [id])

  @@index([createdAt])
  @@index([domainAuthority])
  @@index([domain])
  @@index([provider])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model ContactRequest {
  id        String   @id
  name      String
  email     String
  phone     String?
  service   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model CrawlJob {
  id                  String        @id
  userId              String
  startUrl            String
  config              Json
  status              CrawlStatus   @default(PENDING)
  createdAt           DateTime      @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?
  cancelledAt         DateTime?
  totalPages          Int           @default(0)
  crawledPages        Int           @default(0)
  failedPages         Int           @default(0)
  skippedPages        Int           @default(0)
  queuedPages         Int           @default(0)
  averageResponseTime Float?
  totalDataSize       BigInt        @default(0)
  errorsCount         Int           @default(0)
  error               String?
  lastErrorAt         DateTime?
  User                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  CrawlResult         CrawlResult[]

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model CrawlResult {
  id                 String      @id
  crawlJobId         String
  url                String
  parentUrl          String?
  depth              Int         @default(0)
  status             CrawlStatus @default(PENDING)
  statusCode         Int?
  contentType        String?
  responseTime       Float?
  contentLength      BigInt      @default(0)
  finalUrl           String?
  discoveredAt       DateTime    @default(now())
  queuedAt           DateTime?
  startedCrawlingAt  DateTime?
  completedAt        DateTime?
  title              String?
  description        String?
  headings           Json?
  textContent        String?
  htmlContent        String?
  links              Json?
  images             Json?
  forms              Json?
  structuredData     Json?
  metaTags           Json?
  openGraph          Json?
  twitterCard        Json?
  performanceMetrics Json?
  screenshot         String?
  error              String?
  errorType          String?
  retryCount         Int         @default(0)
  CrawlJob           CrawlJob    @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)

  @@index([crawlJobId])
  @@index([discoveredAt])
  @@index([status])
  @@index([url])
}

model Domain {
  id         Int      @id @default(autoincrement())
  domainName String   @unique
  ipAddress  String?
  pdfData    Bytes?
  pdfPath    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  userId     String?
}

model KeywordData {
  id               String           @id
  keyword          String
  searchVolume     Int              @default(0)
  competition      CompetitionLevel @default(MEDIUM)
  cpc              Decimal          @default(0.0000) @db.Decimal(10, 4)
  competitionIndex Int              @default(0)
  trend            Json?
  intent           SearchIntent     @default(INFORMATIONAL)
  relatedKeywords  Json?
  suggestions      Json?
  provider         ApiProvider
  apiUsageId       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  ApiUsage         ApiUsage?        @relation(fields: [apiUsageId], references: [id])

  @@index([createdAt])
  @@index([keyword])
  @@index([provider])
  @@index([searchVolume])
}

model KeywordSearch {
  id         Int      @id @default(autoincrement())
  keyword    String
  platform   String
  searchType String
  country    String
  language   String
  createdAt  DateTime @default(now())
  results    Json
  userId     String?
}

model KeywordTracking {
  id           String   @id
  userId       String
  keyword      String
  targetUrl    String
  currentRank  Int?
  previousRank Int?
  searchVolume Int?
  difficulty   Int?
  country      String   @default("US")
  language     String   @default("en")
  isTracking   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isTracking])
  @@index([keyword])
  @@index([userId])
}

model PageSpeedResults {
  id                 String              @id
  url                String
  strategy           String
  overallScore       Int
  performanceScore   Int
  accessibilityScore Int
  bestPracticesScore Int
  seoScore           Int
  fcp                Decimal?            @db.Decimal(10, 2)
  fcpStatus          CoreWebVitalStatus?
  lcp                Decimal?            @db.Decimal(10, 2)
  lcpStatus          CoreWebVitalStatus?
  cls                Decimal?            @db.Decimal(10, 4)
  clsStatus          CoreWebVitalStatus?
  tbt                Int?
  tbtStatus          CoreWebVitalStatus?
  tti                Int?
  ttiStatus          CoreWebVitalStatus?
  recommendations    Json?
  opportunities      Json?
  diagnostics        Json?
  passedAudits       Json?
  apiUsageId         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  ApiUsage           ApiUsage?           @relation(fields: [apiUsageId], references: [id])

  @@index([createdAt])
  @@index([overallScore])
  @@index([strategy])
  @@index([url])
}

model SEOToolResult {
  id        String      @id
  userId    String
  toolType  SEOToolType
  url       String
  result    Json
  createdAt DateTime    @default(now())
  updatedAt DateTime
  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolType])
  @@index([userId])
}

model ServiceRequest {
  id                     String               @id
  createdAt              DateTime             @default(now())
  updatedAt              DateTime
  question               String
  websiteType            String
  reference              String?
  name                   String
  phoneNumber            String
  email                  String
  brandName              String
  brandAge               String
  brandDescription       String
  hasDomain              Boolean
  domainName             String?
  websitesUnderDomain    String?
  hasHosting             Boolean
  needsLogo              Boolean
  categoryPages          String
  needsContent           Boolean
  providingProductImages Boolean
  additionalRequirements String?
  budget                 String
  status                 ServiceRequestStatus @default(PENDING)

  @@index([createdAt])
  @@index([email])
  @@index([status])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model SiteAudit {
  id                    String        @id
  userId                String
  url                   String
  status                AuditStatus   @default(PENDING)
  digitalCertaintyIndex Int?          @default(0)
  seoScore              Int?          @default(0)
  accessibilityScore    Int?          @default(0)
  performanceScore      Int?          @default(0)
  qualityScore          Int?          @default(0)
  totalPages            Int?          @default(0)
  crawledPages          Int?          @default(0)
  totalIssues           Int?          @default(0)
  criticalIssues        Int?          @default(0)
  warningIssues         Int?          @default(0)
  infoIssues            Int?          @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime
  AuditIssue            AuditIssue[]
  AuditReport           AuditReport[]
  AuditResult           AuditResult[]
  User                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model User {
  id                 String               @id(map: "User_new_pkey")
  name               String?
  email              String?              @unique
  emailVerified      DateTime?
  image              String?
  isPremium          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  clerkId            String?              @unique
  hasTrial           Boolean              @default(false)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  subscriptionPlan   SubscriptionPlan?    @default(FREE)
  ApiCost            ApiCost[]
  ApiQuota           ApiQuota[]
  ApiUsage           ApiUsage[]
  CompetitorAnalysis CompetitorAnalysis[]
  CrawlJob           CrawlJob[]
  KeywordTracking    KeywordTracking[]
  SEOToolResult      SEOToolResult[]
  SiteAudit          SiteAudit[]
  UserFeatureAccess  UserFeatureAccess[]
  UserSubscription   UserSubscription?
  UserTrial          UserTrial?
}

model UserFeatureAccess {
  id          String      @id
  userId      String
  feature     FeatureType
  hasAccess   Boolean     @default(false)
  trialAccess Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  User        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
}

model UserSubscription {
  id                 String           @id
  userId             String           @unique
  plan               SubscriptionPlan @default(FREE)
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  User               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserTrial {
  id          String    @id
  userId      String    @unique
  isActive    Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  lastRenewed DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserUsage {
  id               Int      @id @default(autoincrement())
  userId           String   @unique
  freeReportsUsed  Int      @default(0)
  freeSearchesUsed Int      @default(0)
  lastResetDate    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ApiProvider {
  PAGESPEED_INSIGHTS
  GOOGLE_KEYWORDS
  AHREFS
  SEMRUSH
  MOZ
}

enum ApiRequestStatus {
  PENDING
  SUCCESS
  FAILED
  RATE_LIMITED
  QUOTA_EXCEEDED
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum CompetitionLevel {
  LOW
  MEDIUM
  HIGH
}

enum CoreWebVitalStatus {
  GOOD
  NEEDS_IMPROVEMENT
  POOR
}

enum CrawlStatus {
  PENDING
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum FeatureType {
  SITE_EXPLORER
  KEYWORDS_EXPLORER
  RANK_TRACKER
  SITE_AUDIT
  WEB_ANALYTICS
  CONTENT_EXPLORER
  AI_CONTENT_HELPER
  DASHBOARD
  PORTFOLIOS
  SITEMAP_CHECKING
  AMAZON_KEYWORD_SEARCH
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportFormat {
  PDF
  CSV
  JSON
  HTML
}

enum ReportType {
  FULL_AUDIT
  SEO_SUMMARY
  ACCESSIBILITY_SUMMARY
  PERFORMANCE_SUMMARY
  CUSTOM
}

enum SEOToolType {
  META_TAGS
  KEYWORD_DENSITY
  HEADER_TAGS
  INTERNAL_LINKS
  ALT_TEXT
  BROKEN_LINKS
  ROBOTS_TXT
  SITEMAP
  SEO_SCORE
  READABILITY
  TITLE_PREVIEW
  DESCRIPTION_PREVIEW
  STRUCTURED_DATA
  CANONICAL_URL
  MOBILE_FRIENDLY
  FULL_AUDIT
  ACCESSIBILITY_AUDIT
  PERFORMANCE_AUDIT
  COMPETITOR_ANALYSIS
}

enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  FREELANCER
  CLIENT
}
